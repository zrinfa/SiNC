# Salin file ini menjadi .env lalu isi kredensial hosting.
# Contoh untuk shared hosting cPanel:
#   DB_HOST=localhost  (beberapa hosting memakai 127.0.0.1 atau server.mysql.hosting.com)
#   DB_NAME=namauser_cnc
#   DB_USER=namauser_cnc
#   DB_PASS=password database di cPanel > MySQL Databases
#   CLIENT_URL=https://domain-anda  (frontend dan API satu domain boleh dikosongkan,
#                                    origin yang sama otomatis dipercaya)
# Untuk dev XAMPP cukup isi DB_NAME=cnc_lms, DB_USER=root, DB_PASS=
DB_HOST=127.0.0.1
DB_NAME=cnc_lms
DB_USER=root
DB_PASS=
CLIENT_URL=http://localhost:5173
JWT_SECRET=ganti-secret-ini-di-produksi
APP_DEBUG=1
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
