# Backend PHP di subdirektori /api (Apache / shared hosting)
Options -Indexes

# File konfigurasi & dump DB tidak boleh diunduh lewat browser
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sql|md|log|bak)$">
  Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^tests/ - [F,L]
# File internal hanya dimuat lewat api.php; akses langsung harus diblok.
RewriteRule ^(lib|routes)(/|$) - [F,L]

# Bearer token harus bisa dibaca PHP. Pada Apache/LiteSpeed shared hosting
# header Authorization sering dibuang sebelum diteruskan ke skrip, jadi
# disalin ke environment REDIRECT_HTTP_AUTHORIZATION (dibaca config.php).
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Semua /api/* → api.php (file & folder asli tetap dilayani langsung,
# termasuk /api/uploads/xxx.pdf hasil upload LKPD guru)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ api.php [QSA,L]
