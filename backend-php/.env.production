# =============================================================
# .env — konfigurasi produksi LMS Simulator Bubut CNC (cPanel)
# File ini TIDAK boleh diakses dari browser; .htaccess sudah memblokirnya.
# Ganti NAMA-DOMAIN dengan domain asli, mis. https://simulasi-cnc.myid.net
# =============================================================

DB_HOST=localhost
DB_NAME=xfag9686_cnc
DB_USER=xfag9686_cnc
DB_PASS=W@nFkRdRv4WCtP2

# Domain frontend. Boleh dipisah koma kalau akses dengan dan tanpa "www".
CLIENT_URL=https://NAMA-DOMAIN,https://www.NAMA-DOMAIN

# Secret penanda token JWT. Ganti kapan pun ingin logout paksa semua user.
JWT_SECRET=561dbff18c5e4559e5c76346f00fdbf63162e77235c19fd0d251cb0b498d4824

# 1 = tampilkan detail error (untuk troubleshooting awal). Kosongkan bila sudah stabil.
APP_DEBUG=

# Opsional: AI tutor pakai LLM (OpenAI-compatible). Kosong = tetap rule-based offline.
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
